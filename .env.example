# Copy to .env for `npm run dev` (Node) and to .dev.vars for `wrangler dev`.
# With no keys set, the app runs fully on fixtures (dry-run). No network, no spend.

# --- Qloo -----------------------------------------------------------------
# Setting this one line switches every Qloo call from fixtures to the live API.
QLOO_API_KEY=
# Optional. Default is the hackathon host. Hackathon keys 401 on api.qloo.com.
QLOO_BASE_URL=https://hackathon.api.qloo.com
# Optional. "fixtures" forces the fixture world even when a key is set.
# QLOO_MODE=fixtures
# Optional. 1 = save each live Qloo response to fixtures/qloo/recorded/ (Node dev server only).
# QLOO_RECORD=1

# --- LLM (provider-agnostic) ---------------------------------------------
# scripted = deterministic dry-run policy, no LLM call, $0 (default when no key is set)
# anthropic = Claude through the Anthropic SDK
# openai-compatible = any /v1/chat/completions endpoint
LLM_PROVIDER=scripted
LLM_MODEL=claude-opus-5-5
ANTHROPIC_API_KEY=
# For openai-compatible only:
# LLM_BASE_URL=https://api.example.com/v1
# LLM_API_KEY=
# Hard cap on agent turns per plan (spend guard).
LLM_MAX_TURNS=24
